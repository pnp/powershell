<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release;DebugLocal</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep this in step with the Microsoft.ApplicationInsights that PowerShell itself ships
         (pwsh 7.6 carries 2.23.0 in its installation folder and loads it at startup for its own
         telemetry). In-IDE (F5) debugging disables our dependency isolation, so this assembly then
         resolves in the default load context, where PowerShell's copy is already loaded - a higher
         reference version than PowerShell's cannot bind there and Connect-PnPOnline fails with
         "The located assembly's manifest definition does not match the assembly reference".
         Microsoft.ApplicationInsights 3.x is not a drop-in: it is a shim over OpenTelemetry and
         drags the Azure Monitor exporter graph (plus its own older MSAL) into the module. -->
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" />
  </ItemGroup>

</Project>
